# Copy to .env and adjust. `.env` is git-ignored and is read automatically
# by docker compose. Nothing in here is a real credential.

# --- Neo4j ---------------------------------------------------------------
NEO4J_PASSWORD=famtree-local-dev
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# --- MongoDB -------------------------------------------------------------
MONGO_PORT=27017
MONGO_DATABASE=famt

# --- Mailpit (catches OTP / welcome-PIN emails) --------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application ---------------------------------------------------------
APP_PORT=8080
# HS256 signing key. Must be >= 32 bytes or jjwt throws WeakKeyException.
# Generate a real one for any shared environment: openssl rand -base64 48
JWT_SECRET=local-development-only-secret-key-at-least-32-bytes-long
